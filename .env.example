# --- First run: leave DEMO_MODE=1 (no keys needed; costs are SYNTHETIC) ---
DEMO_MODE=1

# --- Real providers: set DEMO_MODE=0 and fill these in ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=            # used only for speech-to-text (Whisper)

# Verify current model slugs at your provider before use. Comma-separated, first = primary, rest = fallbacks.
CHAT_MODELS=anthropic/claude-sonnet-4.6,openai/gpt-4o-mini
VISION_MODELS=anthropic/claude-sonnet-4.6,openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
STT_MODEL=whisper-1

# Put YOUR providers' current prices in a copy of config/pricing.example.json and point here.
PRICING_PATH=config/pricing.example.json

# Limits and policy
MAX_TICKET_COST_USD=0.25
REVIEW_CONFIDENCE_THRESHOLD=0.6
MAX_IMAGE_SIDE=1024
MAX_IMAGE_BYTES=5000000
MAX_AUDIO_BYTES=10000000
TOP_K=4
MODEL_TIMEOUT_SECONDS=30
MODEL_RETRIES=1
KB_DIR=data/knowledge_base
